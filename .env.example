# Copy to .env.local and adjust. Every VITE_ variable is bundled into the browser code,
# so never put a secret here that you would not want visible in DevTools.

# Model tag to preselect, e.g. gemma3:1b. Leave empty to pick one in the setup wizard.
VITE_MODEL=

# Base URL for the model server. Empty = the local Ollama daemon via the /ollama dev proxy.
# For an OpenAI-compatible server (LM Studio, llama.cpp, vLLM) use e.g. http://localhost:1234/v1
VITE_BASE_URL=

# Optional bearer key for an OpenAI-compatible endpoint.
VITE_API_KEY=

# How long to wait for the model before falling back, in milliseconds.
VITE_TIMEOUT_MS=90000

# Location used when the browser denies geolocation (default: Bhubaneswar, India).
VITE_DEFAULT_LAT=20.2961
VITE_DEFAULT_LON=85.8245

# Set to true for public static hosting (the Pages workflow does this): start without a model, skip the wizard.
VITE_HOSTED=
